# Apps Script web app URL (Deploy -> Web app -> /exec)
VITE_API_URL=https://script.google.com/macros/s/XXXX/exec
# Sub-path when hosted under a folder (GitHub Pages: /Magmafy-CRM/). Use / for a domain root.
VITE_BASE_PATH=/
# browser | hash
VITE_ROUTER=browser
# 1 = in-browser mock API with sample data (development only)
VITE_MOCK=0
VITE_DEFAULT_LANG=ar
VITE_DEFAULT_THEME=dark
